/* Somente prontuário SAE: não altera o RH CIAPI ou menus globais. */
.sae-perfil-nav { width: 100%; overflow-x: auto; padding: 2px 0 8px; }
.sae-perfil-nav__items { display:flex; gap:8px; min-width:max-content; background:#fff; padding:8px; border:1px solid #dbe5f1; border-radius:14px; }
.sae-perfil-nav__items button { color:#365575; border-radius:9px; white-space:nowrap; }
.sae-perfil-nav__items button:hover { background:#edf5ff; color:#135baf; }
.sae-perfil-nav__items button[class*='bg-primary'],.sae-perfil-nav__items button[aria-current='page'] {color:#fff;}
.sae-resumo-subnav { display:flex; flex-wrap:wrap; gap:9px; padding:10px; border-radius:14px; border:1px solid #dce6f2; background:#fff; }
.sae-resumo-subnav button { display:inline-flex; align-items:center; gap:8px; border:1px solid #dce6f2; border-radius:10px; padding:10px 15px; color:#214565; font-size:13px; font-weight:700; }
.sae-resumo-subnav button.is-active {background:#176bc6; border-color:#176bc6; color:white;}
.sae-resumo-count {background:#e8f1fe; color:#1e5d9c; border-radius:20px; padding:2px 7px; font-size:11px;}
.sae-resumo-subnav button.is-active .sae-resumo-count {background:#fff; color:#155da9;}
.sae-resumo-vitals {border:1px solid #dce6f2; border-radius:16px; background:#fff; padding:20px;}
.sae-resumo-vitals__head {margin-bottom:16px;}
.sae-resumo-vitals__head h2 {font-size:17px; font-weight:800; color:#143b62;}
.sae-resumo-vitals__head p {margin-top:4px; font-size:12px; color:#617b96;}
.sae-doc-folders {display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px;}
.sae-doc-folder {display:flex; gap:12px; text-align:left; align-items:center; padding:18px 15px; background:#fff; border:1px solid #dbe5f1; border-radius:14px; color:#3974af; min-width:0; transition: border-color .15s,background .15s;}
.sae-doc-folder span {display:grid; gap:3px; min-width:0;}
.sae-doc-folder strong {color:#183e64; font-size:13px; overflow-wrap:anywhere;}
.sae-doc-folder small {color:#6d8299; font-size:11px;}
.sae-doc-folder:hover,.sae-doc-folder.is-active {background:#edf6ff; border-color:#468fec;}
.sae-doc-folder.is-active {box-shadow:0 0 0 1px #468fec inset;}
@media(max-width:900px){.sae-doc-folders{grid-template-columns:repeat(2,minmax(0,1fr));}}
@media(max-width:480px){.sae-doc-folders{grid-template-columns:1fr 1fr;gap:7px}.sae-doc-folder{padding:12px 8px;gap:7px}.sae-doc-folder strong{font-size:11px;}}


/* SAE 2026 — padronização clara restrita ao prontuário, sem mudanças globais. */
.sae-prontuario-institucional { color:#193a5d; }
.sae-prontuario-institucional .app-surface,
.sae-prontuario-institucional [class*="bg-card-dark"],
.sae-prontuario-institucional [class*="bg-slate-800"],
.sae-prontuario-institucional [class*="bg-slate-900"],
.sae-prontuario-institucional [class*="bg-\[\#0b1220\]"] {background:#fff!important; border-color:#dce6f1!important; box-shadow:0 3px 14px rgba(21,49,82,.045);}
.sae-prontuario-institucional [class*="text-white"] {color:#13385e!important;}
.sae-prontuario-institucional [class*="text-slate-200"],
.sae-prontuario-institucional [class*="text-slate-300"] {color:#345576!important;}
.sae-prontuario-institucional [class*="text-slate-400"],
.sae-prontuario-institucional [class*="text-slate-500"],
.sae-prontuario-institucional [class*="text-slate-600"] {color:#637d99!important;}
.sae-prontuario-institucional [class*="border-border-dark"] {border-color:#dce6f1!important;}
.sae-prontuario-institucional .sae-perfil-nav__items {width:max-content; max-width:100%;box-shadow:0 2px 10px #1531520a;}
.sae-prontuario-institucional .sae-perfil-nav__items button {min-height:42px;padding:10px 20px!important; font-size:13px; font-weight:700;}
.sae-prontuario-institucional .sae-perfil-nav__items button[class*="bg-primary"] {background:#176bc6!important; color:white!important;}
.sae-prontuario-institucional .sae-doc-folder {background:white!important;}
.sae-prontuario-institucional .sae-doc-folder.is-active {background:#eaf4ff!important;}
.sae-prontuario-institucional button[class*="bg-primary"]:not(.sae-perfil-nav__items button) {background:#176bc6;}
.sae-prontuario-institucional button[class*="bg-primary"]:not(.sae-perfil-nav__items button) [class*="text-white"] {color:white!important;}
.sae-prontuario-institucional .sae-resumo-vitals {background:white;}
.sae-prontuario-institucional .sae-resumo-subnav {margin-top:4px;}
.sae-prontuario-institucional :is(input,select,textarea) {color:#173a60;}
@media(max-width:640px){.sae-prontuario-institucional .sae-perfil-nav__items button{padding:10px 12px!important;}}
